# =============================================================================
# Assistente Virtual — variáveis de ambiente
# =============================================================================
# Copie para .env e preencha. O .env NUNCA vai para o git (RNF-02).
#
#   cp .env.example .env
#   chmod 600 .env
#
# Gere segredos com:
#   openssl rand -hex 32
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
APP_ENV=production               # development | production
APP_DOMAIN=seu-dominio.duckdns.org
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=America/Sao_Paulo
DEFAULT_CURRENCY=BRL

# --- Banco de dados ----------------------------------------------------------
POSTGRES_USER=assistente
POSTGRES_PASSWORD=TROQUE_ISTO_openssl_rand_hex_32
POSTGRES_DB=assistente_virtual
# DATABASE_URL é montada automaticamente pelo docker-compose a partir das
# variáveis acima. Só defina manualmente se usar Postgres externo.

# --- HTTPS / Caddy -----------------------------------------------------------
ACME_EMAIL=seu-email@exemplo.com          # avisos de expiração do Let's Encrypt

# --- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=                        # obtido com @BotFather
TELEGRAM_WEBHOOK_SECRET=TROQUE_ISTO        # enviado no header X-Telegram-Bot-Api-Secret-Token
WEBHOOK_SECRET_PATH=TROQUE_ISTO            # trecho aleatório do caminho da URL

# --- LLM ---------------------------------------------------------------------
# Abstração de provider (RNF-08): trocar de nuvem para local deve ser só config.
LLM_PROVIDER=openai                        # openai | anthropic | google | ollama
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=                              # preencha só para Ollama/vLLM: http://ollama:11434/v1
LLM_TEMPERATURE=0.1                        # baixo: queremos extração determinística
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=30

# Modelo com visão, para o OCR de recibo (RF-36). Pode ser o mesmo do acima.
LLM_VISION_MODEL=gpt-4o-mini

# --- Google Calendar (RF-20) -------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://seu-dominio.duckdns.org/api/auth/google/callback
GOOGLE_CALENDAR_SYNC_MODE=polling          # polling | push
GOOGLE_SYNC_INTERVAL_MINUTES=15

# --- Criptografia de segredos por usuário (RNF-03) ---------------------------
# Chave para cifrar refresh tokens do Google em repouso.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Scheduler (RF-75 a RF-81) -----------------------------------------------
SCHEDULER_ENABLED=true
REMINDER_CHECK_INTERVAL_SECONDS=60
DEFAULT_REMINDER_MINUTES=30
DAILY_SUMMARY_TIME=07:00
WEEKLY_REPORT_WEEKDAY=1                    # 1=segunda ... 7=domingo

# --- Armazenamento de anexos (Q-03) ------------------------------------------
STORAGE_BACKEND=local                      # local | s3
MEDIA_ROOT=/app/media
MEDIA_MAX_SIZE_MB=10
MEDIA_RETENTION_DAYS=90                    # Q-04: retenção das imagens de recibo

# --- Limites e custo ---------------------------------------------------------
RATE_LIMIT_MESSAGES_PER_MINUTE=20          # RNF-17
RATE_LIMIT_MESSAGES_PER_DAY=300
TRACK_LLM_COST=true                        # RNF-18

# --- Observabilidade ---------------------------------------------------------
SENTRY_DSN=                                # opcional
